@model myhijyenProje.Models.Product

@{
    ViewData["Title"] = Model.Name;

    decimal discountRate = 0;
    decimal discountedPrice = Model.Price;

    if (ViewBag.DiscountRate != null)
    {
        discountRate = Convert.ToDecimal(ViewBag.DiscountRate);
    }

    if (ViewBag.DiscountedPrice != null)
    {
        discountedPrice = Convert.ToDecimal(ViewBag.DiscountedPrice);
    }

    var reviews = ViewBag.Reviews as List<myhijyenProje.Models.ProductReview>;
    var similarProducts = ViewBag.SimilarProducts as List<myhijyenProje.Models.Product>;
}

<div class="container mt-4">

    <div class="row">
        <div class="col-md-6">
            <img src="@Model.ImageUrl"
                 class="img-fluid rounded shadow-sm mb-3"
                 alt="@Model.Name" />

            @if (Model.Images != null && Model.Images.Any())
            {
                <div class="row">
                    @foreach (var image in Model.Images)
                    {
                        <div class="col-3 mb-2">
                            <img src="@image.ImageUrl"
                                 class="img-fluid rounded border"
                                 alt="@Model.Name" />
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-md-6">
            <h2>@Model.Name</h2>

            @if (Model.Category != null)
            {
                <p class="text-muted">@Model.Category.Name</p>
            }

            @if (discountRate > 0)
            {
                <div class="mb-3">
                    <span class="text-muted text-decoration-line-through fs-5">
                        @Model.Price.ToString("N2") TL
                    </span>

                    <strong class="text-success fs-2 d-block">
                        @discountedPrice.ToString("N2") TL
                    </strong>

                    <span class="badge bg-success fs-6">
                        %@discountRate Kurumsal İndirim
                    </span>
                </div>
            }
            else
            {
                <strong class="fs-2 d-block mb-3">
                    @Model.Price.ToString("N2") TL
                </strong>
            }

            <p>@Model.Description</p>

            @if (!string.IsNullOrWhiteSpace(Model.Details))
            {
                <div class="mt-3">
                    <h5>Ürün Detayları</h5>
                    <p>@Model.Details</p>
                </div>
            }

            <p class="mt-3">
                <strong>Stok:</strong> @Model.Stock
            </p>

            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-4">
                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.Id" />

                <button type="submit" class="btn btn-dark btn-lg">
                    Sepete Ekle
                </button>
            </form>
        </div>
    </div>

    <hr class="my-5" />

    <div class="row">
        <div class="col-md-6">
            <h4>Yorum Yap</h4>

            <form asp-action="AddReview" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="productId" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label">Puan</label>
                    <select name="rating" class="form-select">
                        <option value="5">5 - Çok iyi</option>
                        <option value="4">4 - İyi</option>
                        <option value="3">3 - Orta</option>
                        <option value="2">2 - Kötü</option>
                        <option value="1">1 - Çok kötü</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Yorum</label>
                    <textarea name="comment" class="form-control" rows="4"></textarea>
                </div>

                <button type="submit" class="btn btn-outline-dark">
                    Yorumu Gönder
                </button>
            </form>
        </div>

        <div class="col-md-6">
            <h4>Yorumlar</h4>

            @if (reviews != null && reviews.Any())
            {
                foreach (var review in reviews)
                {
                    <div class="border rounded p-3 mb-2">
                        <strong>@review.Rating / 5</strong>
                        <p class="mb-1">@review.Comment</p>
                        <small class="text-muted">
                            @review.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                        </small>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">Henüz yorum yok.</p>
            }
        </div>
    </div>

    @if (similarProducts != null && similarProducts.Any())
    {
        <hr class="my-5" />

        <h4>Benzer Ürünler</h4>

        <div class="row mt-3">
            @foreach (var product in similarProducts)
            {
                decimal similarDiscountedPrice = product.Price;

                if (discountRate > 0)
                {
                    similarDiscountedPrice = Math.Round(product.Price - (product.Price * discountRate / 100), 2);
                }

                <div class="col-md-3 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <a asp-action="Details" asp-route-id="@product.Id">
                            <img src="@product.ImageUrl"
                                 class="card-img-top"
                                 alt="@product.Name"
                                 style="height: 200px; object-fit: cover;" />
                        </a>

                        <div class="card-body">
                            <h6>@product.Name</h6>

                            @if (discountRate > 0)
                            {
                                <span class="text-muted text-decoration-line-through">
                                    @product.Price.ToString("N2") TL
                                </span>

                                <strong class="text-success d-block">
                                    @similarDiscountedPrice.ToString("N2") TL
                                </strong>
                            }
                            else
                            {
                                <strong>@product.Price.ToString("N2") TL</strong>
                            }

                            <a asp-action="Details"
                               asp-route-id="@product.Id"
                               class="btn btn-sm btn-outline-dark mt-2">
                                İncele
                            </a>

                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@product.Id" />

                                <button type="submit" class="btn btn-dark btn-sm w-100">
                                    Sepete Ekle
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
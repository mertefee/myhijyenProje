@model myhijyenProje.Models.Product

@{
    ViewData["Title"] = Model.Name;

    var productImages = Model.Images != null && Model.Images.Any()
        ? Model.Images.ToList()
        : new List<myhijyenProje.Models.ProductImage>();

    var mainImage = productImages.FirstOrDefault()?.ImageUrl
        ?? Model.ImageUrl
        ?? "/images/no-image.png";
}

<div class="container mt-4 mb-5">

    <div class="row">
        <div class="col-md-6">

            <div id="productImageCarousel" class="carousel slide product-carousel" data-bs-ride="false">

                <div class="carousel-inner product-carousel-inner shadow-sm rounded">

                    @if (productImages.Any())
                    {
                        for (int i = 0; i < productImages.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@productImages[i].ImageUrl"
                                     class="d-block w-100 product-main-image"
                                     alt="@Model.Name" />
                            </div>
                        }
                    }
                    else
                    {
                        <div class="carousel-item active">
                            <img src="@mainImage"
                                 class="d-block w-100 product-main-image"
                                 alt="@Model.Name" />
                        </div>
                    }

                </div>

                @if (productImages.Count > 1)
                {
                    <button class="carousel-control-prev custom-carousel-btn"
                            type="button"
                            data-bs-target="#productImageCarousel"
                            data-bs-slide="prev">
                        <span class="carousel-control-prev-icon custom-carousel-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Önceki</span>
                    </button>

                    <button class="carousel-control-next custom-carousel-btn"
                            type="button"
                            data-bs-target="#productImageCarousel"
                            data-bs-slide="next">
                        <span class="carousel-control-next-icon custom-carousel-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Sonraki</span>
                    </button>
                }
            </div>

            @if (productImages.Count > 1)
            {
                <div class="d-flex gap-2 mt-3 flex-wrap">
                    @for (int i = 0; i < productImages.Count; i++)
                    {
                        <button type="button"
                                data-bs-target="#productImageCarousel"
                                data-bs-slide-to="@i"
                                class="product-thumbnail @(i == 0 ? "active-thumbnail" : "")">
                            <img src="@productImages[i].ImageUrl"
                                 alt="@Model.Name" />
                        </button>
                    }
                </div>
            }

        </div>

        <div class="col-md-6">
            <h2>@Model.Name</h2>

            @if (Model.Category != null)
            {
                <p class="text-muted">@Model.Category.Name</p>
            }

            <h3 class="mt-4">@Model.Price.ToString("N2") TL</h3>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="mt-4">@Model.Description</p>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Details))
            {
                <div class="mt-3">
                    <h5>Ürün Detayları</h5>
                    <p>@Model.Details</p>
                </div>
            }

            <p class="mt-3">
                <strong>Stok:</strong> @Model.Stock
            </p>

            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-4">
                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.Id" />

                <button type="submit" class="btn btn-dark btn-lg" @(Model.Stock <= 0 ? "disabled" : "")>
                    Sepete Ekle
                </button>
            </form>
        </div>
    </div>

</div>

<style>
    .product-carousel {
        width: 100%;
        max-width: 430px;
        background: #fff;
    }

    .product-carousel-inner {
        width: 100%;
        height: 360px;
        background: #fff;
        border: 1px solid #eee;
    }

    .product-main-image {
        width: 100%;
        height: 360px;
        object-fit: contain;
        padding: 20px;
        background: #fff;
    }

    .custom-carousel-btn {
        width: 42px;
        height: 42px;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(0, 0, 0, 0.65);
        border-radius: 50%;
        opacity: 1;
    }

    .carousel-control-prev.custom-carousel-btn {
        left: 10px;
    }

    .carousel-control-next.custom-carousel-btn {
        right: 10px;
    }

    .custom-carousel-icon {
        width: 18px;
        height: 18px;
    }

    .product-thumbnail {
        width: 95px;
        height: 95px;
        border: 1px solid #ddd;
        background: #fff;
        border-radius: 8px;
        padding: 6px;
        cursor: pointer;
    }

        .product-thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .product-thumbnail:hover,
        .active-thumbnail {
            border: 2px solid #212529;
        }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const carouselElement = document.getElementById("productImageCarousel");
            const thumbnails = document.querySelectorAll(".product-thumbnail");

            if (carouselElement) {
                carouselElement.addEventListener("slid.bs.carousel", function (event) {
                    thumbnails.forEach(x => x.classList.remove("active-thumbnail"));

                    if (thumbnails[event.to]) {
                        thumbnails[event.to].classList.add("active-thumbnail");
                    }
                });
            }
        });
    </script>
}
@model IEnumerable<myhijyenProje.Models.Product>

@{
    ViewData["Title"] = "Mağaza";

    decimal discountRate = 0;

    if (ViewBag.DiscountRate != null)
    {
        discountRate = Convert.ToDecimal(ViewBag.DiscountRate);
    }
}

<div class="container mt-4">

    <div class="position-relative mb-4">
        <img src="~/images/Banner.png"
             class="img-fluid w-100 rounded shadow-sm"
             alt="Banner"
             style="max-height: 200px; object-fit: cover;" />
    </div>

    <div class="row">

        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="mb-3">Kategoriler</h5>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary w-100 mb-2">
                        Tümü
                    </a>

                    @if (ViewBag.Categories != null)
                    {
                        foreach (var category in ViewBag.Categories)
                        {
                            <a asp-action="Index"
                               asp-route-categoryId="@category.Id"
                               class="btn btn-outline-dark w-100 mb-2">
                                @category.Name (@category.Count)
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-md-9">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Ürünler</h2>
            </div>

            <form method="get" asp-action="Index" class="mb-4">
                <div class="input-group">
                    <input type="text"
                           name="q"
                           value="@ViewBag.SearchQuery"
                           class="form-control"
                           placeholder="Ürün ara..." />

                    <button type="submit" class="btn btn-dark">
                        Ara
                    </button>
                </div>
            </form>

            <div class="row">
                @foreach (var product in Model)
                {
                    decimal discountedPrice = product.Price;

                    if (discountRate > 0)
                    {
                        discountedPrice = Math.Round(product.Price - (product.Price * discountRate / 100), 2);
                    }

                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 shadow-sm border-0">

                            <a asp-action="Details" asp-route-id="@product.Id">
                                <img src="@product.ImageUrl"
                                     class="card-img-top"
                                     alt="@product.Name"
                                     style="height: 200px; object-fit: cover;" />
                            </a>

                            <div class="card-body d-flex flex-column">
                                <h6>@product.Name</h6>

                                @if (product.Category != null)
                                {
                                    <span class="text-muted small mb-2">
                                        @product.Category.Name
                                    </span>
                                }

                                <p class="card-text text-muted small">
                                    @product.Description
                                </p>

                                <div class="mt-auto">

                                    @if (discountRate > 0)
                                    {
                                        <span class="text-muted text-decoration-line-through">
                                            @product.Price.ToString("N2") TL
                                        </span>

                                        <strong class="text-success d-block">
                                            @discountedPrice.ToString("N2") TL
                                        </strong>

                                        <span class="badge bg-success">
                                            %@discountRate
                                        </span>
                                    }
                                    else
                                    {
                                        <strong>
                                            @product.Price.ToString("N2") TL
                                        </strong>
                                    }

                                    <div class="d-grid mt-2">
                                        <a asp-action="Details"
                                           asp-route-id="@product.Id"
                                           class="btn btn-outline-dark btn-sm mb-2">
                                            Detay
                                        </a>

                                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@product.Id" />

                                            <button type="submit" class="btn btn-dark btn-sm w-100">
                                                Sepete Ekle
                                            </button>
                                        </form>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>

        </div>

    </div>
</div>
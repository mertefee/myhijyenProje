@model myhijyenProje.Models.Product

@{
    ViewData["Title"] = "Ürün Ekle";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Ürün Ekle</h2>
            <p class="text-muted mb-0">Yeni ürün bilgilerini ve görsellerini buradan ekleyebilirsin.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Listeye Dön
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h5 class="mb-0">Ürün Bilgileri</h5>
        </div>

        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Ürün Adı</label>
                    <input asp-for="Name" class="form-control" placeholder="Ürün adı girin" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Kısa açıklama"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Details" class="form-label">Detay</label>
                    <textarea asp-for="Details" class="form-control" rows="5" placeholder="Ürün detaylarını girin"></textarea>
                    <span asp-validation-for="Details" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label">Fiyat</label>
                        <input asp-for="Price" class="form-control" placeholder="0.00" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Stock" class="form-label">Stok</label>
                        <input asp-for="Stock" class="form-control" placeholder="Stok miktarı" />
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label">Kategori</label>
                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                        <option value="">Kategori seçiniz</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label">Ürün Görselleri</label>
                    <input type="file"
                           name="imageFiles"
                           multiple
                           accept=".jpg,.jpeg,.png,.webp"
                           class="form-control" />

                    <div class="form-text">
                        JPG, JPEG, PNG veya WEBP yükleyebilirsin. Her görsel maksimum 5 MB olmalıdır.
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Kaydet
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        İptal
                    </a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
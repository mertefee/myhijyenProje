@model IEnumerable<myhijyenProje.Models.Order>

<h2>Siparişler</h2>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>No</th>
            <th>Tarih</th>
            <th>Müşteri</th>
            <th>Toplam</th>
            <th>Durum</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>#@o.Id</td>
                <td>@o.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@o.FullName</td>
                <td>@o.Total ₺</td>
                <td>
                    <span class="badge bg-secondary">@o.Status</span>
                </td>
                <td>
                    <a class="btn btn-sm btn-dark"
                       asp-action="Details"
                       asp-route-id="@o.Id">
                        Detay
                    </a>

                    <a class="btn btn-sm btn-secondary"
                       asp-action="DownloadPdf"
                       asp-route-id="@o.Id">
                        PDF
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
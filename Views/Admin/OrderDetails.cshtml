@model myhijyenProje.Models.Order

@{
    ViewData["Title"] = "Sipariş Detayı";
}

<style>
    .order-detail-page {
        background: #f5f7fb;
        margin: -24px;
        padding: 32px;
        min-height: 100vh;
    }

    .detail-hero {
        background: linear-gradient(135deg, #111827, #1f2937);
        color: white;
        border-radius: 24px;
        padding: 28px;
        box-shadow: 0 20px 50px rgba(15, 23, 42, .18);
    }

    .premium-card {
        border: 0;
        border-radius: 22px;
        box-shadow: 0 16px 40px rgba(15, 23, 42, .08);
    }

    .info-label {
        color: #6b7280;
        font-size: 13px;
    }

    .info-value {
        font-weight: 700;
        color: #111827;
    }

    .status-badge {
        border-radius: 999px;
        padding: 8px 14px;
        background: #eef2ff;
        color: #3730a3;
        font-weight: 700;
    }
</style>

<div class="order-detail-page">

    <div class="detail-hero mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between gap-3">
            <div>
                <h2 class="mb-1">Sipariş #@Model.Id</h2>
                <p class="mb-0 text-white-50">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
            </div>

            <div class="text-md-end">
                <div class="mb-2">
                    <span class="status-badge">@Model.Status</span>
                </div>
                <h3 class="mb-0">@Model.Total ₺</h3>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-lg-5">
            <div class="card premium-card mb-4">
                <div class="card-body">
                    <h5 class="mb-3">Müşteri Bilgileri</h5>

                    <div class="mb-3">
                        <div class="info-label">Ad Soyad</div>
                        <div class="info-value">@Model.FullName</div>
                    </div>

                    <div class="mb-3">
                        <div class="info-label">Telefon</div>
                        <div class="info-value">@Model.Phone</div>
                    </div>

                    <div class="mb-3">
                        <div class="info-label">Adres</div>
                        <div class="info-value">@Model.Address</div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Note))
                    {
                        <div class="mb-3">
                            <div class="info-label">Not</div>
                            <div class="info-value">@Model.Note</div>
                        </div>
                    }
                </div>
            </div>

            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-dark rounded-pill">
                Dashboard'a Dön
            </a>
        </div>

        <div class="col-lg-7">
            <div class="card premium-card">
                <div class="card-body">
                    <h5 class="mb-3">Sipariş Ürünleri</h5>

                    @if (Model.Items != null && Model.Items.Any())
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Ürün</th>
                                        <th>Adet</th>
                                        <th>Birim Fiyat</th>
                                        <th>Toplam</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td class="fw-bold">@item.ProductName</td>
                                            <td>@item.Quantity</td>
                                            <td>@item.UnitPrice ₺</td>
                                            <td class="fw-bold">@(item.UnitPrice * item.Quantity) ₺</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between align-items-center">
                            <strong>Genel Toplam</strong>
                            <h4 class="mb-0">@Model.Total ₺</h4>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Bu siparişte ürün bulunamadı.</p>
                    }
                </div>
            </div>
        </div>

    </div>

</div>
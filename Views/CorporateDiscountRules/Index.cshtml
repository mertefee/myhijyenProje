@model IEnumerable<myhijyenProje.Models.CorporateDiscountRule>

@{
    ViewData["Title"] = "Kurumsal İndirimler";
}

<h2>Kurumsal İndirimler</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Yeni İndirim Kuralı Ekle</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mail Uzantısı</th>
            <th>İndirim Oranı</th>
            <th>Admin Onayı</th>
            <th>Durum</th>
            <th>Oluşturulma</th>
            <th style="width:220px;">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rule in Model)
        {
            <tr>
                <td>@rule.EmailDomain</td>
                <td>%@rule.DiscountPercentage</td>
                <td>
                    @if (rule.RequiresAdminApproval)
                    {
                        <span class="badge bg-warning text-dark">Gerekli</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Gerekli Değil</span>
                    }
                </td>
                <td>
                    @if (rule.IsActive)
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Pasif</span>
                    }
                </td>
                <td>@rule.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@rule.Id" class="btn btn-sm btn-warning">Düzenle</a>

                    <form asp-action="Delete" asp-route-id="@rule.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger"
                                onclick="return confirm('Bu indirim kuralı silinsin mi?')">
                            Sil
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>